{
  "name": "@hooman-loop/konstrukt",
  "version": "2.0.0",
  "description": "Konstrukt \u2014 The Hooman Loop design system. JSON-first design tokens with CSS, Swift/SwiftUI, JSON, and a text/ASCII output layer.",
  "author": "The Hooman Loop",
  "homepage": "https://thehoomanloop.com/konstrukt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-hooman-loop/konstrukt.git"
  },
  "bugs": {
    "url": "https://github.com/the-hooman-loop/konstrukt/issues"
  },
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build/build.mjs",
    "build:llms": "node build/llms-full.mjs",
    "check": "npm run check:parity && npm run check:contrast",
    "check:parity": "node build/check-parity.mjs",
    "check:contrast": "node build/check-contrast.mjs",
    "check:text": "python3 src/text/check.py",
    "check:llms": "node build/llms-full.mjs --check",
    "snapshot": "node build/build.mjs && cp dist/css/konstrukt.css build/canonical-tokens.css",
    "docs": "python3 -m http.server 4340 -d docs"
  },
  "exports": {
    "./css": "./dist/css/konstrukt.css",
    "./base.css": "./dist/css/base.css",
    "./theme.js": "./dist/css/theme.js",
    "./text.css": "./dist/css/text.css",
    "./tokens.json": "./dist/tokens.json",
    "./text.json": "./dist/text.json",
    "./text.py": "./dist/text.py"
  },
  "devDependencies": {
    "style-dictionary": "^5.0.0"
  }
}
