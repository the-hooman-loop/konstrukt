{
  "$description": "Dark-mode overrides. Only roles whose value differs from semantic.json appear here; status tokens follow automatically through their var() references.",

  "bg":           { "$type": "color", "$value": "{color.neutral.950}" },
  "bg-alt":       { "$type": "color", "$value": "{color.neutral.900}" },
  "surface":      { "$type": "color", "$value": "{color.neutral.875}" },

  "text":         { "$type": "color", "$value": "{color.neutral.150}" },
  "text-muted":   { "$type": "color", "$value": "{color.neutral.400}" },
  "ink":          { "$type": "color", "$value": "{color.neutral.150}" },

  "border":       { "$type": "color", "$value": "{color.neutral.500}" },
  "border-light": { "$type": "color", "$value": "{color.neutral.800}" },

  "accent":       { "$type": "color", "$value": "{color.teal.400}" },
  "accent-soft":  { "$type": "color", "$value": "{color.teal.900}" },
  "accent-light": { "$type": "color", "$value": "{color.teal.950}" },
  "on-accent":    { "$type": "color", "$value": "{color.neutral.950}" },
  "focus":        { "$type": "color", "$value": "{color.teal.400}" },

  "success":      { "$type": "color", "$value": "{color.green.300}" },
  "success-bg":   { "$type": "color", "$value": "{color.green.900}" },
  "warning":      { "$type": "color", "$value": "{color.ochre.300}" },
  "warning-bg":   { "$type": "color", "$value": "{color.ochre.900}" },
  "danger":       { "$type": "color", "$value": "{color.red.300}" },
  "danger-bg":    { "$type": "color", "$value": "{color.red.900}" },
  "info":         { "$type": "color", "$value": "{color.blue.300}" },
  "info-bg":      { "$type": "color", "$value": "{color.blue.900}" },

  "status": {
    "draft":    { "$type": "color", "$value": "{color.neutral.400}" },
    "draft-bg": { "$type": "color", "$value": "{color.neutral.850}" }
  },

  "category": {
    "1":    { "$type": "color", "$value": "{color.blue.300}" },
    "1-bg": { "$type": "color", "$value": "{color.blue.900}" },
    "2":    { "$type": "color", "$value": "{color.violet.300}" },
    "2-bg": { "$type": "color", "$value": "{color.violet.900}" },
    "3":    { "$type": "color", "$value": "{color.ochre.300}" },
    "3-bg": { "$type": "color", "$value": "{color.ochre.900}" },
    "4":    { "$type": "color", "$value": "{color.yellow.300}" },
    "4-bg": { "$type": "color", "$value": "{color.yellow.950}" },
    "5":    { "$type": "color", "$value": "{color.green.300}" },
    "5-bg": { "$type": "color", "$value": "{color.green.900}" }
  },

  "selection-bg": { "$type": "color", "$value": "{color.yellow.300}" },
  "selection-fg": { "$type": "color", "$value": "{color.neutral.950}" }
}
