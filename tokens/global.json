{
  "font": {
    "sans":    { "$type": "fontFamily", "$value": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, sans-serif" },
    "display": { "$type": "fontFamily", "$value": "\"Space Grotesk\", system-ui, sans-serif" },
    "mono":    { "$type": "fontFamily", "$value": "\"SF Mono\", \"Fira Code\", \"Consolas\", monospace" }
  },

  "type": {
    "size": {
      "10": { "$type": "dimension", "$value": "0.625rem" },
      "11": { "$type": "dimension", "$value": "0.6875rem" },
      "12": { "$type": "dimension", "$value": "0.75rem" },
      "13": { "$type": "dimension", "$value": "0.8125rem" },
      "14": { "$type": "dimension", "$value": "0.875rem" },
      "15": { "$type": "dimension", "$value": "0.9375rem" },
      "16": { "$type": "dimension", "$value": "1rem" },
      "18": { "$type": "dimension", "$value": "1.125rem" },
      "24": { "$type": "dimension", "$value": "1.5rem" },
      "36": { "$type": "dimension", "$value": "2.25rem" },
      "56": { "$type": "dimension", "$value": "3.5rem" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.03em" },
      "heading": { "$type": "dimension", "$value": "-0.02em" },
      "tight":   { "$type": "dimension", "$value": "-0.01em" },
      "caps":    { "$type": "dimension", "$value": "0.04em" },
      "badge":   { "$type": "dimension", "$value": "0.06em" },
      "label":   { "$type": "dimension", "$value": "0.08em" }
    },
    "leading": {
      "display": { "$type": "number", "$value": 1.05 },
      "heading": { "$type": "number", "$value": 1.25 },
      "title":   { "$type": "number", "$value": 1.3 },
      "snug":    { "$type": "number", "$value": 1.4 },
      "compact": { "$type": "number", "$value": 1.55 },
      "body":    { "$type": "number", "$value": 1.65 }
    },

    "display":    { "$type": "typography", "$value": { "fontFamily": "var(--font-display)", "fontSize": "var(--type-size-56)", "fontWeight": "var(--type-weight-bold)",     "lineHeight": "var(--type-leading-display)", "letterSpacing": "var(--type-tracking-display)", "textTransform": "none" } },
    "heading":    { "$type": "typography", "$value": { "fontFamily": "var(--font-display)", "fontSize": "var(--type-size-24)", "fontWeight": "var(--type-weight-bold)",     "lineHeight": "var(--type-leading-heading)", "letterSpacing": "var(--type-tracking-heading)", "textTransform": "none" } },
    "subheading": { "$type": "typography", "$value": { "fontFamily": "var(--font-display)", "fontSize": "var(--type-size-16)", "fontWeight": "var(--type-weight-semibold)", "lineHeight": "var(--type-leading-snug)",    "letterSpacing": "var(--type-tracking-caps)",    "textTransform": "uppercase" } },
    "label":      { "$type": "typography", "$value": { "fontFamily": "var(--font-display)", "fontSize": "var(--type-size-11)", "fontWeight": "var(--type-weight-bold)",     "lineHeight": "var(--type-leading-body)",    "letterSpacing": "var(--type-tracking-label)",   "textTransform": "uppercase" } },
    "badge":      { "$type": "typography", "$value": { "fontFamily": "var(--font-display)", "fontSize": "var(--type-size-10)", "fontWeight": "var(--type-weight-bold)",     "lineHeight": "var(--type-leading-body)",    "letterSpacing": "var(--type-tracking-badge)",   "textTransform": "uppercase" } },
    "body":       { "$type": "typography", "$value": { "fontFamily": "var(--font-sans)",    "fontSize": "var(--type-size-16)", "fontWeight": "var(--type-weight-regular)",  "lineHeight": "var(--type-leading-body)",    "letterSpacing": "0em",                          "textTransform": "none" } },
    "meta":       { "$type": "typography", "$value": { "fontFamily": "var(--font-sans)",    "fontSize": "var(--type-size-13)", "fontWeight": "var(--type-weight-regular)",  "lineHeight": "var(--type-leading-body)",    "letterSpacing": "0em",                          "textTransform": "none" } },
    "mono":       { "$type": "typography", "$value": { "fontFamily": "var(--font-mono)",    "fontSize": "var(--type-size-13)", "fontWeight": "var(--type-weight-regular)",  "lineHeight": "var(--type-leading-body)",    "letterSpacing": "0em",                          "textTransform": "none" } }
  },

  "sp": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },

  "stroke": {
    "hairline": { "$type": "dimension", "$value": "1px", "$description": "Card and table hairlines." },
    "rule":     { "$type": "dimension", "$value": "2px", "$description": "The signature ink rule: module tops, section dividers, nav underline." },
    "rail":     { "$type": "dimension", "$value": "4px", "$description": "Accent rails on modules, cards and code blocks." }
  },

  "radius":     { "$type": "dimension", "$value": "0px" },
  "transition": { "$type": "other",     "$value": "150ms ease" }
}
