{
  "$description": "Raw color ramps. Never emitted as CSS custom properties: semantic and theme tokens reference them as {color.<hue>.<step>} and the build resolves the reference to a literal.",
  "color": {
    "neutral": {
      "0":    { "$type": "color", "$value": "#FFFFFF" },
      "50":   { "$type": "color", "$value": "#F5F5F0" },
      "100":  { "$type": "color", "$value": "#EBEBEB" },
      "125":  { "$type": "color", "$value": "#ECEAE4" },
