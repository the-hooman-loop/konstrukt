{
  "$description": "Light-mode semantic roles (the :root defaults). Values reference primitives as {color.*} or other roles as var(--*). Dark mode overrides only what differs, in themes/dark.json.",

  "bg":           { "$type": "color", "$value": "{color.neutral.50}" },
  "bg-alt":       { "$type": "color", "$value": "{color.neutral.100}" },
  "surface":      { "$type": "color", "$value": "{color.neutral.0}" },

  "text":         { "$type": "color", "$value": "{color.neutral.1000}" },
  "text-muted":   { "$type": "color", "$value": "{color.neutral.600}" },
  "ink":          { "$type": "color", "$value": "{color.neutral.1000}", "$description": "Structural rules: 2px dividers, module top borders, table headers. Matches text in both modes today but is a separate role." },

  "border":       { "$type": "color", "$value": "{color.neutral.1000}", "$description": "Outlines of interactive controls. Must hold 3:1 against surface." },
  "border-light": { "$type": "color", "$value": "{color.neutral.200}", "$description": "Decorative hairlines only; exempt from the contrast gate." },

  "accent":       { "$type": "color", "$value": "{color.teal.700}" },
  "accent-soft":  { "$type": "color", "$value": "{color.teal.100}" },
  "accent-light": { "$type": "color", "$value": "{color.teal.50}" },
  "on-accent":    { "$type": "color", "$value": "{color.neutral.0}", "$description": "Text and icons on a solid accent fill." },
  "focus":        { "$type": "color", "$value": "{color.teal.700}", "$description": "Focus ring. Teal rather than ink so it never reads as one more structural rule." },

  "success":      { "$type": "color", "$value": "{color.green.700}" },
  "success-bg":   { "$type": "color", "$value": "{color.green.100}" },
  "warning":      { "$type": "color", "$value": "{color.ochre.700}" },
  "warning-bg":   { "$type": "color", "$value": "{color.ochre.100}" },
  "danger":       { "$type": "color", "$value": "{color.red.700}" },
  "danger-bg":    { "$type": "color", "$value": "{color.red.100}" },
  "info":         { "$type": "color", "$value": "{color.blue.700}" },
  "info-bg":      { "$type": "color", "$value": "{color.blue.100}" },

  "status": {
    "draft":          { "$type": "color", "$value": "{color.neutral.650}" },
    "draft-bg":       { "$type": "color", "$value": "{color.neutral.125}" },
    "review":         { "$type": "color", "$value": "var(--accent)" },
    "review-bg":      { "$type": "color", "$value": "var(--accent-soft)" },
    "complete":       { "$type": "color", "$value": "var(--success)" },
    "complete-bg":    { "$type": "color", "$value": "var(--success-bg)" },
    "in-progress":    { "$type": "color", "$value": "var(--warning)" },
    "in-progress-bg": { "$type": "color", "$value": "var(--warning-bg)" },
    "launched":       { "$type": "color", "$value": "var(--info)" },
    "launched-bg":    { "$type": "color", "$value": "var(--info-bg)" }
  },

  "category": {
    "$description": "Generic categorical slots for tags and segments. Products map their own names onto these numbers; the design system does not know what a category means.",
    "1":    { "$type": "color", "$value": "{color.blue.700}" },
    "1-bg": { "$type": "color", "$value": "{color.blue.100}" },
    "2":    { "$type": "color", "$value": "{color.violet.700}" },
    "2-bg": { "$type": "color", "$value": "{color.violet.100}" },
    "3":    { "$type": "color", "$value": "{color.ochre.700}" },
    "3-bg": { "$type": "color", "$value": "{color.ochre.100}" },
    "4":    { "$type": "color", "$value": "{color.yellow.800}" },
    "4-bg": { "$type": "color", "$value": "{color.yellow.200}" },
    "5":    { "$type": "color", "$value": "{color.green.700}" },
    "5-bg": { "$type": "color", "$value": "{color.green.100}" }
  },

  "selection-bg": { "$type": "color", "$value": "{color.yellow.200}" },
  "selection-fg": { "$type": "color", "$value": "{color.yellow.950}" },

  "shadow": { "$type": "other", "$value": "none" }
}
